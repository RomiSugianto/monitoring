# Copy to .env and fill in values for local runs.

# Prometheus Remote Write endpoint
# Example for local Prometheus with remote-write receiver:
# REMOTE_WRITE_URL=http://localhost:9090/api/v1/write
PROMETHEUS_REMOTE_WRITE_URL=http://localhost:9090/api/v1/write

# Optional basic auth for remote write.
# For Grafana Cloud remote-write, set these if your endpoint requires it.
# PROMETHEUS_REMOTE_WRITE_USERNAME=your_username
# PROMETHEUS_REMOTE_WRITE_PASSWORD=your_password_or_token

# If you set TLS options, do it via CA bundle rather than disabling verification.
# Provide a path to a CA bundle file if your endpoint uses a private CA.
# PROMETHEUS_REMOTE_WRITE_CA_CERT_PATH=

# Set to 1 to print request/response diagnostics.
# DEBUG_REMOTE_WRITE=0

