{
	"id": null,
	"uid": "slo-dashboard-node-exporter",
	"title": "SLO node-exporter",
	"description": "A minimal example dashboard",
	"tags": ["SLO"],
	"timezone": "browser",
	"schemaVersion": 36,
	"version": 0,
	"refresh": "30s",
	"time": {
		"from": "now-1h",
		"to": "now"
	},
	"panels": [
		{
			"id": 1,
			"type": "text",
			"title": "",
			"gridPos": { "h": 4, "w": 9, "x": 0, "y": 0 },
			"transparent": true,
			"options": { "content": "# node-exporter SLO\n", "mode": "markdown" }
		},
		{
			"id": 2,
			"type": "stat",
			"title": "",
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"gridPos": { "h": 2, "w": 5, "x": 9, "y": 0 },
			"fieldConfig": {
				"defaults": {
					"color": { "mode": "thresholds" },
					"mappings": [
						{
							"options": {
								"from": 1e-10,
								"result": { "text": "FIRING" },
								"to": 1
							},
							"type": "range"
						},
						{
							"options": { "from": -1, "result": { "text": "OK" }, "to": 0 },
							"type": "range"
						}
					],
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "orange", "value": 1 }
						]
					},
					"unit": "short"
				},
				"overrides": []
			},
			"options": {
				"colorMode": "background",
				"graphMode": "none",
				"justifyMode": "auto",
				"orientation": "vertical",
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				},
				"textMode": "value_and_name",
				"wideLayout": true
			},
			"links": [
				{
					"title": "View alert rule",
					"type": "link",
					"targetBlank": true,
					"url": "/alerting/list?queryString=grafana_slo_severity%3Dcritical%2Capp%3Dnode-exporter"
				}
			],
			"targets": [
				{
					"refId": "A",
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "max((count(GRAFANA_ALERTS{app=\"node-exporter\", grafana_slo_severity=\"critical\", alertstate=\"firing\"})) OR on() vector(0))",
					"instant": true,
					"range": false,
					"legendFormat": "Critical alert"
				}
			]
		},
		{
			"id": 3,
			"type": "stat",
			"title": "",
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"gridPos": { "h": 2, "w": 5, "x": 9, "y": 2 },
			"fieldConfig": {
				"defaults": {
					"color": { "mode": "thresholds" },
					"mappings": [
						{
							"options": {
								"from": 1e-10,
								"result": { "text": "FIRING" },
								"to": 1
							},
							"type": "range"
						},
						{
							"options": { "from": -1, "result": { "text": "OK" }, "to": 0 },
							"type": "range"
						}
					],
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "orange", "value": 1 }
						]
					},
					"unit": "short"
				},
				"overrides": []
			},
			"options": {
				"colorMode": "background",
				"graphMode": "none",
				"justifyMode": "auto",
				"orientation": "vertical",
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				},
				"textMode": "value_and_name",
				"wideLayout": true
			},
			"links": [
				{
					"title": "View alert rule",
					"type": "link",
					"targetBlank": true,
					"url": "/alerting/list?queryString=grafana_slo_severity%3Dwarning%2Capp%3Dnode-exporter"
				}
			],
			"targets": [
				{
					"refId": "A",
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "max((count(GRAFANA_ALERTS{app=\"node-exporter\", grafana_slo_severity=\"warning\", alertstate=\"firing\"})) OR on() vector(0))",
					"instant": true,
					"range": false,
					"legendFormat": "Warning alert"
				}
			]
		},
		{
			"id": 4,
			"type": "stat",
			"title": "Time Window",
			"description": "The time window over which the service level objective is being measured over",
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"gridPos": { "h": 4, "w": 5, "x": 14, "y": 0 },
			"fieldConfig": {
				"defaults": {
					"color": { "mode": "thresholds" },
					"thresholds": {
						"mode": "absolute",
						"steps": [{ "color": "super-light-blue", "value": null }]
					},
					"unit": "percentunit"
				},
				"overrides": []
			},
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "auto",
				"orientation": "auto",
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "/.*/",
					"values": false
				},
				"textMode": "auto",
				"wideLayout": true
			},
			"targets": [
				{
					"refId": "time_window",
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "sli_info{app=\"node-exporter\"}",
					"instant": true,
					"range": false,
					"legendFormat": "__auto"
				}
			],
			"transformations": [
				{
					"id": "labelsToFields",
					"options": { "mode": "rows", "keepLabels": ["window"] }
				},
				{
					"id": "organize",
					"options": {
						"excludeByName": { "label": true },
						"indexByName": {},
						"renameByName": { "label": "time_period", "value": "Time Window" }
					}
				}
			]
		},
		{
			"id": 5,
			"type": "stat",
			"title": "SLO",
			"description": "The SLO's Objective value. Always between 0 and 100%",
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"gridPos": { "h": 4, "w": 5, "x": 19, "y": 0 },
			"fieldConfig": {
				"defaults": {
					"color": { "mode": "thresholds" },
					"decimals": 2,
					"thresholds": {
						"mode": "absolute",
						"steps": [{ "color": "super-light-blue", "value": null }]
					},
					"unit": "percentunit"
				},
				"overrides": []
			},
			"options": {
				"colorMode": "value",
				"graphMode": "none",
				"justifyMode": "auto",
				"orientation": "auto",
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				},
				"textMode": "value",
				"wideLayout": true
			},
			"targets": [
				{
					"refId": "A",
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "sli_objective{app=\"node-exporter\"}",
					"instant": true,
					"range": false,
					"legendFormat": "__auto"
				}
			]
		},
		{
			"id": 6,
			"type": "timeseries",
			"title": "SLI",
			"description": "Service level indicator",
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"gridPos": { "h": 7, "w": 19, "x": 0, "y": 8 },
			"fieldConfig": {
				"defaults": {
					"color": { "mode": "thresholds" },
					"custom": {
						"drawStyle": "line",
						"lineWidth": 2,
						"fillOpacity": 0,
						"gradientMode": "scheme",
						"axisSoftMax": 0.05,
						"lineInterpolation": "linear",
						"showPoints": "auto",
						"spanNulls": false,
						"stacking": { "group": "A", "mode": "none" },
						"thresholdsStyle": { "mode": "off" }
					},
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "red", "value": null }
						]
					},
					"unit": "percentunit",
					"max": 1
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom",
					"showLegend": false
				},
				"tooltip": { "mode": "single", "sort": "none" }
			},
			"targets": [
				{
					"refId": "recorded_data",
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "clamp_max(avg by(app) (avg_over_time(sli_5m{app=\"node-exporter\"}[$__interval:])), 1)",
					"instant": false,
					"range": true,
					"legendFormat": "__auto"
				},
				{
					"refId": "threshold",
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "sli_objective{app=\"node-exporter\"}",
					"instant": true,
					"range": false,
					"legendFormat": "__auto"
				}
			],
			"transformations": [
				{
					"id": "configFromData",
					"options": {
						"configRefId": "threshold",
						"mappings": [
							{
								"fieldName": "{__name__=\"sli_objective\", app=\"node-exporter\"}",
								"handlerKey": "threshold1",
								"handlerArguments": { "threshold": { "color": "green" } }
							}
						],
						"applyTo": { "id": "byType", "options": "number" }
					}
				}
			]
		},
		{
			"id": 7,
			"type": "stat",
			"title": "30d SLI",
			"description": "Service level indicator's value over the last 30d",
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"gridPos": { "h": 7, "w": 5, "x": 19, "y": 8 },
			"fieldConfig": {
				"defaults": {
					"color": { "mode": "thresholds" },
					"decimals": 3,
					"noValue": "No data",
					"thresholds": {
						"mode": "absolute",
						"steps": [{ "color": "red", "value": null }]
					},
					"unit": "percentunit",
					"min": 0,
					"max": 1
				},
				"overrides": []
			},
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "auto",
				"orientation": "auto",
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				},
				"textMode": "auto",
				"wideLayout": true
			},
			"targets": [
				{
					"refId": "recorded_data",
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "clamp_max(avg by(app) (sli_window{app=\"node-exporter\"}), 1)",
					"instant": true,
					"range": false,
					"legendFormat": "__auto"
				},
				{
					"refId": "threshold",
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "sli_objective{app=\"node-exporter\"}",
					"instant": true,
					"range": false,
					"legendFormat": "__auto"
				}
			],
			"transformations": [
				{
					"id": "configFromData",
					"options": {
						"configRefId": "threshold",
						"mappings": [
							{
								"fieldName": "{__name__=\"sli_objective\", app=\"node-exporter\"}",
								"handlerKey": "threshold1",
								"handlerArguments": { "threshold": { "color": "green" } }
							}
						],
						"applyTo": { "id": "byType", "options": "number" }
					}
				}
			]
		},
		{
			"id": 8,
			"type": "timeseries",
			"title": "Error Budget Trend",
			"description": "If error budget is decreasing over time, it means that your service is spending its error budget faster than it's earning it back.\n\n If error budget is increasing overtime, you're not spending too much of your error budget.",
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"gridPos": { "h": 7, "w": 19, "x": 0, "y": 15 },
			"fieldConfig": {
				"defaults": {
					"color": { "mode": "thresholds" },
					"custom": {
						"drawStyle": "line",
						"lineWidth": 1,
						"fillOpacity": 0,
						"gradientMode": "scheme",
						"axisSoftMax": 1,
						"axisSoftMin": 0,
						"lineInterpolation": "linear",
						"showPoints": "auto",
						"spanNulls": false,
						"stacking": { "group": "A", "mode": "none" },
						"thresholdsStyle": { "mode": "off" }
					},
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "red", "value": null },
							{ "color": "yellow", "value": 0 },
							{ "color": "green", "value": 0.2 }
						]
					},
					"unit": "percentunit",
					"max": 1
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom",
					"showLegend": false
				},
				"tooltip": { "mode": "single", "sort": "none" }
			},

			"targets": [
				{
					"refId": "error_budget_trend",
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "(avg by (app) (clamp_max(avg_over_time((sli_5m{app=\"node-exporter\"} < +Inf)[$__range:5m]), 1)) - on (app) sli_objective{app=\"node-exporter\"}) / (1 - sli_objective{app=\"node-exporter\"})",
					"instant": false,
					"range": true,
					"legendFormat": "__auto"
				}
			]
		},
		{
			"id": 9,
			"type": "stat",
			"title": "30d Remaining Error Budget",
			"description": "The unspent error budget over the last {0.9995 30d} Window",
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"gridPos": { "h": 7, "w": 5, "x": 19, "y": 15 },
			"fieldConfig": {
				"defaults": {
					"color": { "mode": "thresholds" },
					"min": 0,
					"noValue": "No data",
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "red", "value": null },
							{ "color": "yellow", "value": 0 },
							{ "color": "green", "value": 0.2 }
						]
					},
					"unit": "percentunit"
				},
				"overrides": []
			},
			"options": {
				"colorMode": "value",
				"graphMode": "area",
				"justifyMode": "auto",
				"orientation": "horizontal",
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				},
				"textMode": "auto",
				"wideLayout": true
			},
			"targets": [
				{
					"refId": "A",
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "(clamp_max(sli_window{app=\"node-exporter\"}, 1) - on (app) group_left () sli_objective{app=\"node-exporter\"}) / on (app) group_left () (1 - sli_objective{app=\"node-exporter\"})",
					"instant": false,
					"range": true,
					"legendFormat": "__auto"
				}
			],
			"transformations": [
				{
					"id": "calculateField",
					"options": {
						"alias": "Error budget left",
						"mode": "reduceRow",
						"reduce": { "reducer": "mean" },
						"replaceFields": true
					}
				}
			]
		},
		{
			"id": 10,
			"type": "timeseries",
			"title": "Error Budget Burn Rate",
			"description": "The burn rate is the rate that this SLO is spending its error budget over last 5 min [0, 1.0]. A 1x burn rate will consume the entire error budget allotted for that period.",
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"gridPos": { "h": 7, "w": 19, "x": 0, "y": 22 },
			"fieldConfig": {
				"defaults": {
					"color": { "mode": "thresholds" },
					"custom": {
						"drawStyle": "line",
						"lineWidth": 2,
						"fillOpacity": 0,
						"gradientMode": "scheme",
						"axisSoftMin": 0,
						"lineInterpolation": "smooth",
						"showPoints": "never",
						"spanNulls": false,
						"stacking": { "group": "A", "mode": "none" },
						"thresholdsStyle": { "mode": "off" }
					},
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "yellow", "value": 1 },
							{ "color": "dark-red", "value": 3 }
						]
					},
					"unit": "none"
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom",
					"showLegend": false
				},
				"tooltip": { "mode": "single", "sort": "none" }
			},
			"targets": [
				{
					"refId": "recorded_data",
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "avg by (app) (1 - clamp_max(avg_over_time(sli_5m{app=\"node-exporter\"}[$__interval:]), 1)) / (1 - sli_objective{app=\"node-exporter\"})",
					"instant": false,
					"range": true,
					"legendFormat": "__auto"
				}
			]
		},
		{
			"id": 11,
			"type": "stat",
			"title": "Current Burn Rate",
			"description": "The burn rate is the rate that this SLO is spending its error budget over last 5 min [0, 1.0]. A 1x burn rate will consume the entire error budget allotted for that period.",
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"gridPos": { "h": 7, "w": 5, "x": 19, "y": 23 },
			"fieldConfig": {
				"defaults": {
					"color": { "mode": "thresholds" },
					"decimals": 2,
					"noValue": "No data",
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "green", "value": null },
							{ "color": "#EAB839", "value": 1 },
							{ "color": "dark-red", "value": 3 }
						]
					},
					"unit": "none"
				},
				"overrides": []
			},
			"options": {
				"colorMode": "value",
				"graphMode": "none",
				"justifyMode": "auto",
				"orientation": "auto",
				"reduceOptions": {
					"calcs": ["lastNotNull"],
					"fields": "",
					"values": false
				},
				"textMode": "auto",
				"wideLayout": true
			},
			"targets": [
				{
					"refId": "A",
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "avg by (app) (1 - clamp_max(avg_over_time(sli_5m{app=\"node-exporter\"}[$__interval:]), 1)) / (1 - sli_objective{app=\"node-exporter\"})",
					"instant": false,
					"range": true,
					"legendFormat": "__auto"
				}
			],
			"transformations": [
				{
					"id": "calculateField",
					"options": {
						"alias": "Error burn rate",
						"mode": "reduceRow",
						"reduce": { "reducer": "mean" },
						"replaceFields": true
					}
				}
			]
		},
		{
			"id": 12,
			"type": "alertlist",
			"title": "Burn Rate Alerts",
			"description": "All active alerts for this SLO",
			"gridPos": { "h": 7, "w": 17, "x": 0, "y": 30 },
			"options": {
				"alertInstanceLabelFilter": "{app=\"node-exporter\"}",
				"alertName": "",
				"dashboardAlerts": false,
				"datasource": "-- Grafana --",
				"folder": "",
				"groupBy": ["grafana_slo_severity"],
				"groupMode": "custom",
				"maxItems": 20,
				"sortOrder": 1,
				"stateFilter": {
					"error": true,
					"firing": true,
					"noData": true,
					"normal": true,
					"pending": true
				},
				"viewMode": "list"
			}
		},
		{
			"id": 13,
			"type": "grafana-assistant-panel",
			"title": "Assistant Investigations",
			"gridPos": { "h": 7, "w": 7, "x": 17, "y": 30 },
			"options": {
				"labels": [{ "name": "app", "value": "node-exporter" }],
				"mode": "investigations"
			}
		},
		{
			"id": 14,
			"type": "timeseries",
			"title": "SLI",
			"description": "Service level indicator",
			"datasource": { "type": "prometheus", "uid": "prometheus" },
			"gridPos": { "h": 7, "w": 19, "x": 0, "y": 32 },
			"fieldConfig": {
				"defaults": {
					"color": { "mode": "thresholds" },
					"custom": {
						"drawStyle": "line",
						"lineWidth": 2,
						"fillOpacity": 0,
						"gradientMode": "scheme",
						"axisSoftMax": 0.05,
						"lineInterpolation": "linear",
						"showPoints": "auto",
						"spanNulls": false,
						"stacking": { "group": "A", "mode": "none" },
						"thresholdsStyle": { "mode": "off" }
					},
					"thresholds": {
						"mode": "absolute",
						"steps": [
							{ "color": "red", "value": null }
						]
					},
					"unit": "percentunit",
					"max": 1
				},
				"overrides": []
			},
			"options": {
				"legend": {
					"displayMode": "list",
					"placement": "bottom",
					"showLegend": false
				},
				"tooltip": { "mode": "single", "sort": "none" }
			},
			"targets": [
				{
					"refId": "recorded_data",
					"datasource": { "type": "prometheus", "uid": "prometheus" },
					"expr": "clamp_max(avg by(app) (avg_over_time(sli_5m{app=\"node-exporter\", category=\"availability\"}[$__interval:])), 1)",
					"instant": false,
					"range": true,
					"legendFormat": "__auto"
				},
				{
