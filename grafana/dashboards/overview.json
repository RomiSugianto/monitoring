					"datasource": {
						"type": "prometheus",
						"uid": "prometheus"
					},
					"editorMode": "builder",
					"expr": "count(\n\t\t(\n\t\t  sum by (app) (sum_over_time((sli_success_count_5m < +Inf)[1d:5m]))\n\t\t  / sum by (app) (sum_over_time((sli_total_count_5m < +Inf)[1d:5m]))\n\t\t  # combine with series that aren't producing sli_success_count_5m and sli_total_count_5m\n\t\t  or avg by (app) (sli_1d)\n\t\t)\n\t\t> on(app) max by (app) (sli_objective)\n\t  ) OR on() vector(0)\n\t  ",
